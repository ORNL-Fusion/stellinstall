#---------------------------------------------------------------
    $ECHO $FILES_TO_MAKE | $AWK '$0 ~ /coilopt/ {sub(/coilopt/,"coilopt coilgeom")} \
    $0 ~ /descur/ {sub(/descur/,"descur descur_plot")} {print $0};' > NEW_FILES
