	cd /u/gscoig/STELLOPT_corrections/trunk && $(MAKE) -f DESCUR/CMakeFiles/xdescur.dir/build.make DESCUR/CMakeFiles/xdescur.dir/Sources/vname1.f.i
.PHONY : Sources/vname1.f.i

Sources/vname1.s: Sources/vname1.f.s

.PHONY : Sources/vname1.s

# target to generate assembly for a file
Sources/vname1.f.s:
	cd /u/gscoig/STELLOPT_corrections/trunk && $(MAKE) -f DESCUR/CMakeFiles/xdescur.dir/build.make DESCUR/CMakeFiles/xdescur.dir/Sources/vname1.f.s
.PHONY : Sources/vname1.f.s

