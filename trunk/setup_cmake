#!/bin/bash
#
#  setup_cmake Chooses the correct cmake build command for a machine.
#
#-----------------------------------------------------------------------------

BUILD_TYPE=Release

MACHINE_ID=`uname -n`

echo Building v3fit suite for machine $MACHINE_ID
echo

if [ $# -eq 1 ]
then
	BUILD_TYPE=Debug
fi

echo cmake configured to generate a $BUILD_TYPE build.
if [ "$BUILD_TYPE" == Debug ]
then
	echo "    cmake may be reconfigured to generate a Release build by running this script with no arguments or using the commmand"	
	echo
	echo "    cmake -DCMAKE_BUILD_TYPE=Release"
else
	echo "    cmake may be reconfigured to generate a Debug build by running this script with a Debug argument or using the commmand"
	echo
	echo "    cmake -DCMAKE_BUILD_TYPE=Debug"
fi

# CMake doesn't like being reconfigured completely. To avoid problems this
# script will delete the CMakeCache.txt file allowing this script to start 
# from a clean slate. Use the -f option on rm to silence any errors from
# rm. This makes will cause rm to ignore the error to occur if 
# CMakeCache.txt doesn't exist.

rm -f CMakeCache.txt
rm -rf CMakeFiles

echo
if [ "$MACHINE_ID" == "blast1" ] || \
   [ "$MACHINE_ID" == "blast2" ] || \
   [ "$MACHINE_ID" == "blast3" ] || \
   [ "$MACHINE_ID" == "blast4" ] || \
   [ "$MACHINE_ID" == "recon"  ] || \
   [ "$MACHINE_ID" == "ubuntu" ]
then
	# These for machines are hosted on the Auburn network.

	cmake -DCMAKE_BUILD_TYPE:String=$BUILD_TYPE \
	      -DCMAKE_Fortran_COMPILER=gfortran     \
	      -DNETCDF_INC_PATH=/usr/include/       \
	      -DNETCDF_LIB_PATH=/usr/lib            \
	      -DEXTRA_FLAGS=-fopenmp                \
	      -DEXTRA_RELEASE_FLAGS:String="-m64 -mfpmath=sse -march=native -msse4a -msse3"

elif [ "$MACHINE_ID" == "recon2" ]
then
	# This machines is hosted on the Auburn network.

	cmake -DCMAKE_BUILD_TYPE:String=$BUILD_TYPE             \
	      -DCMAKE_Fortran_COMPILER=gfortran                 \
	      -DNETCDF_INC_PATH=/usr/include/                   \
	      -DNETCDF_LIB_PATH=/usr/lib                        \
	      -DNETCDF_F_LIB_NAME=libnetcdff.so.5               \
	      -DNETCDF_C_LIB_NAME=libnetcdf.so.7                \
	      -DBLACS_LIB_NAME=libblacs-openmpi.so.1            \
	      -DBLACS_CINIT_NAME=libblacsCinit-openmpi.so.1     \
	      -DBLACS_F77INIT_NAME=libblacsF77init-openmpi.so.1 \
	      -DSCALAPACK_LIB_NAME=libscalapack-openmpi.so.1    \
	      -DUSE_PARVMEC=ON                                  \
	      -DEXTRA_FLAGS="-fopenmp -DNEW_CODE"               \
	      -DEXTRA_RELEASE_FLAGS:String="-m64 -mfpmath=sse -march=native -msse4a -msse3"

elif [ "${MACHINE_ID#*.}" == "igi.cnr.it" ]; then

	# the machine is hosted on RFX's network:
	# for technical reasons, force compiling on ra22 only.

	if [ "${MACHINE_ID%%.*}" != "ra22" ]; then
	   echo " `basename $0`: you should compile on ra22!" && exit 1
	fi

	echo " `basename $0`: running cmake."
	cmake -DEXTRA_FLAGS=-openmp                        \
	      -DCMAKE_C_COMPILER=mpiicc                    \
	      -DCMAKE_CXX_COMPILER=mpiicpc                 \
	      -DCMAKE_Fortran_COMPILER=mpiifort            \
	      -DNETCDF_INC_PATH=/usr/local/netcdf/include/ \
	      -DNETCDF_LIB_PATH=/usr/local/netcdf/lib/     \
	      -DCMAKE_BUILD_TYPE=$BUILD_TYPE               \
	&&   echo " `basename $0`: cmake succeeded."       \
	|| ( echo " `basename $0`: cmake failed." && exit 2 )

elif [ $MACHINE_ID == "rat.rfx.local" ]
then
# the machine is hosted on RFX's network:

	echo " `basename $0`: running cmake."
	cmake -DEXTRA_FLAGS=-openmp                                                \
	      -DCMAKE_C_COMPILER=/usr/local/intel/impi_latest/bin64/mpiicc         \
	      -DCMAKE_CXX_COMPILER=/usr/local/intel/impi_latest/bin64/mpiicpc      \
	      -DCMAKE_Fortran_COMPILER=/usr/local/intel/impi_latest/bin64/mpiifort \
	      -DNETCDF_INC_PATH=/usr/local/netcdf-fortran/include/                 \
	      -DNETCDF_LIB_PATH=/usr/local/netcdf-fortran/lib/                     \
	      -DCMAKE_BUILD_TYPE=$BUILD_TYPE                                       \
	      -DCMAKE_PREFIX_PATH:FILEPATH=/usr/local/intel/impi_latest/lib64      \
	      -DMPI_Fortran_INCLUDE_PATH=/usr/local/intel/impi_latest/include64    \
	&&   echo " `basename $0`: cmake succeeded."                               \
	|| ( echo " `basename $0`: cmake failed." && exit 2 )

elif [ $MACHINE_ID == "r2d2.gat.com" ]
then

	# r2d2 at General Atomics has the LAPACK and BLAS libraries
	# in a non standard location. Variables for these will need
	# to be set manually.

	cmake -DCMAKE_BUILD_TYPE:String=$BUILD_TYPE                                                                 \
	      -DCMAKE_Fortran_COMPILER=gfortran44                                                                   \
	      -DNETCDF_INC_PATH=/usr/include/                                                                       \
	      -DNETCDF_LIB_PATH=/usr/lib                                                                            \
	      -DEXTRA_FLAGS=-fopenmp                                                                                \
	      -DEXTRA_RELEASE_FLAGS:String="-m64 -mfpmath=sse -march=native -msse4a -msse3"                         \
	      -DBLAS_blas_LIBRARY:FILEPATH="/usr/local/lapack-3.4.2/librefblas.a"                                   \
	      -DCMAKE_PREFIX_PATH:FILEPATH="/usr/local/openmpi;/usr/local/lapack-3.4.2/;/usr/local/scalapack-2.0.2" \
	      -DUSE_PARVMEC=ON

elif [ $MACHINE_ID == "venusa" ]
then

	# venus cluster at general atomics. Note cmake version 
	# 2.6.4 and 2.8 are installed on venus. Use the 2.8 version
	# venus has multiple compilers installed force all the gcc
	# compilers to use version 4.4.

	cmake28 -DCMAKE_BUILD_TYPE:String=$BUILD_TYPE                                         \
	        -DCMAKE_C_COMPILER=gcc44                                                      \
	        -DCMAKE_CXX_COMPILER=g++44                                                    \
	        -DCMAKE_Fortran_COMPILER=gfortran44                                           \
	        -DNETCDF_INC_PATH:FILEPATH=/c/source/netcdf/netcdf-4.1.3_g44/include          \
	        -DNETCDF_LIB_PATH:FILEPATH=/c/source/netcdf/netcdf-4.1.3_g44/lib              \
	        -DEXTRA_FLAGS=-fopenmp                                                        \
	        -DEXTRA_RELEASE_FLAGS:String="-m64 -mfpmath=sse -march=native -msse4a -msse3"

elif [ $MACHINE_ID == "mbp103254"     ] || \
     [ $MACHINE_ID == "mbp103254-2"   ] || \
     [ $MACHINE_ID == "cianciosaimac" ]
then
	# Config for Mark Cianciosa's ORNL machine.

        cmake -DCMAKE_BUILD_TYPE:String=$BUILD_TYPE \
              -DCMAKE_Fortran_COMPILER=gfortran     \
              -DNETCDF_INC_PATH=/usr/local/include/ \
              -DNETCDF_LIB_PATH=/usr/local/lib      \
              -DEXTRA_FLAGS="-fopenmp -DNEW_CODE"   \
              -DUSE_PARVMEC=ON                      \
              -DUSE_FAST_COPY=ON

elif [ $MACHINE_ID == "swim.ornl.gov"    ] || \
     [ $MACHINE_ID == "fusion2.ornl.gov" ]
then

        # Machines hosted on the ORNL network.

        # Make sure mpi is in the path due to the install configuration.
        export LD_LIBRARY_PATH=/usr/lib64/openmpi/lib:$LD_LIBRARY_PATH
        export PATH=/usr/lib64/openmpi/bin:$PATH

        cmake -DCMAKE_BUILD_TYPE:String=$BUILD_TYPE                                         \
              -DCMAKE_Fortran_COMPILER=gfortran                                             \
              -DNETCDF_INC_PATH=/usr/include                                                \
              -DNETCDF_LIB_PATH=/usr/lib64/openmpi/lib                                      \
              -DEXTRA_FLAGS="-fopenmp -DNEW_CODE"                                           \
              -DCMAKE_PREFIX_PATH:FILEPATH=/usr/lib64/openmpi/lib                           \
              -DEXTRA_RELEASE_FLAGS:String="-m64 -mfpmath=sse -march=native -msse4a -msse3" \
              -DUSE_PARVMEC=ON                                                              \
              -DUSE_FAST_COPY=ON

elif [ $MACHINE_ID == "r2d2" ]
then

    	# Machines hosted on the ORNL network.

        cmake -DCMAKE_BUILD_TYPE:String=$BUILD_TYPE                                                                \
              -DCMAKE_Fortran_COMPILER=gfortran                                                                    \
              -DNETCDF_INC_PATH=/usr/local/netcdf/netcdf-fortran-4.2/fortran                                       \
              -DNETCDF_F=/usr/local/netcdf/netcdf-fortran-4.2/fortran/.libs/libnetcdff.so                          \
              -DNETCDF_C="/usr/local/netcdf/netcdf-4.2.1.1/liblib/.libs/libnetcdf.so"                              \
              -DCMAKE_PREFIX_PATH:FILEPATH="/usr/local/openmpi;/usr/local/lapack-3.4.2;/usr/local/scalapack-2.0.2" \
              -DBLAS_blas_LIBRARY:FILEPATH="/usr/local/lapack-3.4.2/librefblas.a"                                  \
              -DEXTRA_FLAGS="-fopenmp -DNEW_CODE"                                                                  \
              -DUSE_PARVMEC=ON                                                                                     \
              -DUSE_FAST_COPY=ON                                                                                   \
              -DEXTRA_RELEASE_FLAGS:String="-m64 -mfpmath=sse -march=native -msse4a -msse3"                        

elif [ $MACHINE_ID == "eos-ext1" ] || \
     [ $MACHINE_ID == "eos-ext2" ]
then

	# Config for ORNL OLCF Machines. OLCF systems use a module system. Load the cmake
	# module to get a compatable version first.

	module load cmake
	module load cray-netcdf/4.3.3.1
	cmake -DCMAKE_BUILD_TYPE=$BUILD_TYPE                                   \
	      -DNETCDF_INC_PATH=$NETCDF_DIR/include                            \
	      -DNETCDF_LIB_PATH=$NETCDF_DIR/lib                                \
	      -DCMAKE_PREFIX_PATH:FILEPATH=$CRAY_MPICH2_DIR                    \
	      -DEXTRA_FLAGS="-openmp -DNEW_CODE"                               \
	      -DSCALAPACK_LIB=$CRAY_LIBSCI_PREFIX_DIR/lib/libsci_gnu_mpi.so    \
	      -DBLAS_LIBRARIES=$CRAY_LIBSCI_PREFIX_DIR/lib/libsci_gnu_mpi.so   \
	      -DLAPACK_LIBRARIES=$CRAY_LIBSCI_PREFIX_DIR/lib/libsci_gnu_mpi.so \
	      -DUSE_PARVMEC=ON                                                 \
	      -DUSE_FAST_COPY=ON

elif [ $MACHINE_ID == "titan-ext1" ] || \
     [ $MACHINE_ID == "titan-ext2" ] || \
     [ $MACHINE_ID == "titan-ext3" ] || \
     [ $MACHINE_ID == "titan-ext4" ] || \
     [ $MACHINE_ID == "titan-ext5" ] || \
     [ $MACHINE_ID == "titan-ext6" ] || \
     [ $MACHINE_ID == "titan-ext7" ]
then

	# Config for ORNL OLCF Machines. OLCF systems use a module system. Load the cmake                                                                                                                                                                                        
	# module to get a compatable version first.                               
	module swap PrgEnv-pgi PrgEnv-gnu
	module load cray-netcdf
	cmake -DCMAKE_BUILD_TYPE=$BUILD_TYPE                                     \
	      -DNETCDF_INC_PATH=$NETCDF_DIR/include                              \
	      -DNETCDF_LIB_PATH=$NETCDF_DIR/lib                                  \
	      -DCMAKE_PREFIX_PATH:FILEPATH=$CRAY_MPICH2_DIR                      \
	      -DEXTRA_FLAGS="-openmp -DNEW_CODE"                                 \
	      -DSCALAPACK_LIB=$CRAY_LIBSCI_PREFIX_DIR/lib/libsci_gnu_mpi.so      \
	      -DBLAS_LIBRARIES=$CRAY_LIBSCI_PREFIX_DIR/lib/libsci_gnu_mpi.so     \
	      -DLAPACK_LIBRARIES=$CRAY_LIBSCI_PREFIX_DIR/lib/libsci_gnu_mpi.so   \
	      -DUSE_PARVMEC=ON                                                   \
	      -DUSE_FAST_COPY=ON

elif [ $MACHINE_ID == "edison01" ] || \
     [ $MACHINE_ID == "edison02" ] || \
     [ $MACHINE_ID == "edison03" ] || \
     [ $MACHINE_ID == "edison04" ] || \
     [ $MACHINE_ID == "edison05" ] || \
     [ $MACHINE_ID == "edison06" ] || \
     [ $MACHINE_ID == "edison07" ] || \
     [ $MACHINE_ID == "edison08" ] || \
     [ $MACHINE_ID == "edison09" ] || \
     [ $MACHINE_ID == "edison10" ] || \
     [ $MACHINE_ID == "edison11" ] || \
     [ $MACHINE_ID == "edison12" ] || \
     [ $MACHINE_ID == "cori01"   ] || \
     [ $MACHINE_ID == "cori02"   ] || \
     [ $MACHINE_ID == "cori03"   ] || \
     [ $MACHINE_ID == "cori04"   ] || \
     [ $MACHINE_ID == "cori05"   ] || \
     [ $MACHINE_ID == "cori06"   ] || \
     [ $MACHINE_ID == "cori07"   ] || \
     [ $MACHINE_ID == "cori08"   ] || \
     [ $MACHINE_ID == "cori09"   ] || \
     [ $MACHINE_ID == "cori10"   ] || \
     [ $MACHINE_ID == "cori11"   ] || \
     [ $MACHINE_ID == "cori12"   ]
then

	# Config for NERSC Edison Machine. OLCF systems use a module system. Load the cmake                                                                                                                                                                                        
	# module to get a compatable version first.                               
	module load cmake
	module load python
	module load cray-netcdf
	cmake -DCMAKE_BUILD_TYPE=$BUILD_TYPE                                  \
	      -DCMAKE_C_COMPILER=icc                                          \
	      -DCMAKE_CXX_COMPILER=icpc                                       \
	      -DCMAKE_Fortran_COMPILER=ifort                                  \
	      -DNETCDF_INC_PATH=$NETCDF_DIR/include                           \
	      -DNETCDF_LIB_PATH=$NETCDF_DIR/lib                               \
	      -DSCALAPACK_LIB=$CRAY_LIBSCI_PREFIX_DIR/lib/libsci_intel_mpi.so \
	      -DCMAKE_PREFIX_PATH:FILEPATH=$MPICH_DIR                         \
	      -DEXTRA_FLAGS="-mkl"                                            \
	      -DUSE_PARVMEC=ON                                                \
	      -DUSE_FAST_COPY=ON

elif [ $MACHINE_ID == "clus45" ]
then

	# Config for the Stellarator cluster at W7-X. The following modules need
	# to be loaded before running the setup script and running unit tests.
	#
	#	module load cmake/3.1-gnu
	#	module load gcc/4.6.4
	#	module load openmpi/1.8-gnu
	#	module load netcdf/4.3-gnu-ompi18-hdf518
	#
	# NOTE: Order matters. Compiler needs to be loaded first.

	cmake -DEXTRA_FLAGS="-fopenmp -DNEW_CODE"                 \
	      -DMPI_Fortran_COMPILER:FILEPATH=$MPI_DIR/bin/mpif90 \
	      -DNETCDF_INC_PATH=$NETCDF_DIR/include/              \
	      -DNETCDF_LIB_PATH=$NETCDF_DIR/lib

elif [ $MACHINE_ID == "Erics-iMac.local" ]
then
	# Config for Eric Howell's Mac.

	cmake -DCMAKE_BUILD_TYPE:String=$BUILD_TYPE                                \
	      -DCMAKE_Fortran_COMPILER=gfortran                                    \
	      -DNETCDF_INC_PATH=/usr/local/include/                                \
	      -DNETCDF_LIB_PATH=/usr/local/lib                                     \
	      -DEXTRA_FLAGS="-fopenmp -DNEW_CODE"                                  \
	      -DUSE_PARVMEC=ON                                                     \
	      -DTRAVIS_LIB_PATH=/Users/erichowell/lib/TRAVIS_161013/TRAVIS-src/lib \
	      -DMCONF_LIB_PATH=/Users/erichowell/lib/TRAVIS_161013/TRAVIS-src/mag_conf/lib

elif [ $MACHINE_ID == "draco01" ] || \
     [ $MACHINE_ID == "draco02" ] || \
     [ $MACHINE_ID == "draco03" ] || \
     [ $MACHINE_ID == "draco04" ]
then
	# Config for IPP Draco cluster
	# Load the following modules prior to running setup_cmake:
	module purge
	module load cmake
	module load gcc
	module load impi
	module load mkl
	module load hdf5-mpi/gcc
	module load netcdf-mpi/gcc
	module list
	#Pre- June 27, 2017
	#Currently Loaded Modulefiles:
 	# 1) cmake/3.5    3) impi/5.1.3   5) hdf5-mpi/gcc/1.8.16
	# 2) gcc/5.4      4) mkl/11.3     6) netcdf-mpi/gcc/4.4.0
	#Post- June 27, 2017
	#Currently Loaded Modulefiles:
	# 1) cmake/3.7    3) impi/2017.3  5) hdf5-mpi/gcc/1.8.18
	# 2) gcc/6.3      4) mkl/2017     6) netcdf-mpi/gcc/4.4.1.1

	cmake -DCMAKE_BUILD_TYPE:String=$BUILD_TYPE       \
	      -DCMAKE_Fortran_COMPILER=gfortran           \
	      -DLAPACK_LIBRARIES="${MKLROOT}/lib/intel64/libmkl_blas95_lp64.a;${MKLROOT}/lib/intel64/libmkl_lapack95_lp64.a;${MKLROOT}/lib/intel64/libmkl_scalapack_lp64.a;-Wl,--start-group ${MKLROOT}/lib/intel64/libmkl_gf_lp64.a;${MKLROOT}/lib/intel64/libmkl_gnu_thread.a;${MKLROOT}/lib/intel64/libmkl_core.a;${MKLROOT}/lib/intel64/libmkl_blacs_intelmpi_lp64.a;-Wl,--end-group" \
	      -DBLAS_LIBRARIES="${MKLROOT}/lib/intel64/libmkl_blas95_lp64.a;-Wl,--start-group ${MKLROOT}/lib/intel64/libmkl_gf_lp64.a;${MKLROOT}/lib/intel64/libmkl_gnu_thread.a;${MKLROOT}/lib/intel64/libmkl_core.a;${MKLROOT}/lib/intel64/libmkl_blacs_intelmpi_lp64.a;-Wl,--end-group"  \
	      -DNETCDF_INC_PATH="${NETCDF_HOME}/include/" \
	      -DNETCDF_LIB_PATH="${NETCDF_HOME}/lib"      \
	      -DSCALAPACK_LIB="${MKLROOT}/lib/intel64/libmkl_scalapack_lp64.a;${MKLROOT}/lib/intel64/libmkl_gf_lp64.a;${MKLROOT}/lib/intel64/libmkl_gnu_thread.a;${MKLROOT}/lib/intel64/libmkl_core.a;${MKLROOT}/lib/intel64/libmkl_blacs_intelmpi_lp64.a" \
	      -DEXTRA_FLAGS="-lgomp -lpthread -lm -ldl -I${MKLROOT}/include/intel64/lp64 -m64 -I${MKLROOT}/include -DNEW_CODE -O3" \
	      -DUSE_PARVMEC=ON                            \
	      -DUSE_FAST_COPY=ON

elif [ $MACHINE_ID == "hydra01" ] || \
     [ $MACHINE_ID == "hydra02" ] || \
     [ $MACHINE_ID == "hydra03" ] || \
     [ $MACHINE_ID == "hydra04" ]
then
	# Config for IPP hydra cluster
	# Load the following modules prior to running setup_cmake:
	module purge
	module load cmake
	module load gcc
	module load mpi.intel
	module load mkl
	module load hdf5-mpi/gcc
	module load netcdf-mpi/gcc
	module list
	#Currently Loaded Modulefiles:
	# on Hydra
	# 1) cmake/3.5    3) mpi.intel/5.1.3        5) hdf5-mpi/gcc/1.8.16
	# 2) gcc/5.4      4) mkl/11.3               6) netcdf-mpi/gcc/4.4.1

	cmake -DCMAKE_BUILD_TYPE:String=$BUILD_TYPE       \
	      -DCMAKE_Fortran_COMPILER=gfortran           \
	      -DUSE_PARVMEC=ON                            \
	      -DLAPACK_LIBRARIES="${MKLROOT}/lib/intel64/libmkl_blas95_lp64.a;${MKLROOT}/lib/intel64/libmkl_lapack95_lp64.a;${MKLROOT}/lib/intel64/libmkl_scalapack_lp64.a;-Wl,--start-group ${MKLROOT}/lib/intel64/libmkl_gf_lp64.a;${MKLROOT}/lib/intel64/libmkl_gnu_thread.a;${MKLROOT}/lib/intel64/libmkl_core.a;${MKLROOT}/lib/intel64/libmkl_blacs_intelmpi_lp64.a;-Wl,--end-group" \
	      -DBLAS_LIBRARIES="${MKLROOT}/lib/intel64/libmkl_blas95_lp64.a;-Wl,--start-group ${MKLROOT}/lib/intel64/libmkl_gf_lp64.a;${MKLROOT}/lib/intel64/libmkl_gnu_thread.a;${MKLROOT}/lib/intel64/libmkl_core.a;${MKLROOT}/lib/intel64/libmkl_blacs_intelmpi_lp64.a;-Wl,--end-group"  \
	      -DNETCDF_INC_PATH="${NETCDF_HOME}/include/" \
	      -DNETCDF_LIB_PATH="${NETCDF_HOME}/lib"      \
	      -DSCALAPACK_LIB="${MKLROOT}/lib/intel64/libmkl_scalapack_lp64.a;${MKLROOT}/lib/intel64/libmkl_gf_lp64.a;${MKLROOT}/lib/intel64/libmkl_gnu_thread.a;${MKLROOT}/lib/intel64/libmkl_core.a;${MKLROOT}/lib/intel64/libmkl_blacs_intelmpi_lp64.a" \
	      -DEXTRA_FLAGS="-lgomp -lpthread -lm -ldl -I${MKLROOT}/include/intel64/lp64 -m64 -I${MKLROOT}/include -DNEW_CODE -O3"

elif [ $MACHINE_ID == "irisa.cluster" ] || \
     [ $MACHINE_ID == "irisb.cluster" ] || \
     [ $MACHINE_ID == "irisc.cluster" ]
then

	# iris cluster at GA

	module purge
	module load scalapack
	module load netcdf
	cmake -DCMAKE_BUILD_TYPE:String=$BUILD_TYPE                    \
	      -DNETCDF_INC_PATH=$NETCDF_DIR/include                    \
	      -DNETCDF_LIB_PATH=$NETCDF_DIR/lib                        \
	      -DCMAKE_C_COMPILER=gcc                                   \
	      -DCMAKE_CXX_COMPILER=g++                                 \
	      -DCMAKE_Fortran_COMPILER=gfortran                        \
	      -DCMAKE_PREFIX_PATH:FILEPATH="$MPICH_DIR;$SCALAPACK_DIR"

else
# MACHINE_ID is new and unknown. Inform the user how to add support for this new machine.
	echo $MACHINE_ID not suported by this script.
	echo To support this machine, add a new elif statement of the form
	echo
	echo elif [ \$MACHINE_ID == \"$MACHINE_ID\" ]
	echo then
	echo "   " cmake -DVARIABLE=value ...
	echo
fi
