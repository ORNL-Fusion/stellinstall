#Set up StellObject awk and sh files

#---------------------------------------------------------------
#
#   NOTE: QUOTES AROUND EOF CAN BE USED TO AVOID HAVING TO ESCAPE (\) ALL
#   THE $ CHARACTERS. THIS WORKS ONLY WHEN THERE ARE NO SHELL SUBSTITUTIONS IN THE CAT-ED SCRIPT.
#
#---------------------------------------------------------------
AWKFILE=StellObj.awk
STELLSH=StellObj.sh
cat > $STELLSH <<EOF
#!/bin/sh
#    Run this script: script_name <FOLDERNAME>, where FOLDERNAME is the top-level child
#    folder name in the stellinstall tree
#    Written by S. P. Hirshman (03/14/16)
     FOLDERNAME=\$1
     DEPEND_FILE=\$FOLDERNAME.dep
     LIST_FILE=ObjectList
     TEMP_FILE=TempList
     OBJ_LIST=ObjectL.txt
     CDIR=\$0

     rm -f \$LIST_FILE
     find ./Sources \( -iname \*.f -or -iname \*.f90 \) > \$LIST_FILE
     sort \$LIST_FILE > \$TEMP_FILE

#    Load list of filenames into array and strip path/extension
#    shellarr=( \`cat "\$OBJ_LIST"\` )

     c1=0
     while read line
     do
# Get the file name
#       base="\`basename \$line\`"
        base="\${line##*/}"  #~2X faster than basename
        var=\${base%.*}   #remove extension including '.'
        c1=\$(expr \$c1 + 1)
        shellarr[\$c1]=\$var
     done < \$TEMP_FILE  

# Save filename list to OBJ_LIST file
     printf "%s\n" "\${shellarr[@]}" > \$OBJ_LIST

# Generate dep file: NOTE IN AWK, \$0 IS THE COMPLETE RECORD, NOT THE COMMAND LINE ARG[0]
     awk -v var1="\$c1" -v var2="\${shellarr[*]}" '{ command="./StellObj.awk "\$0" "var1" "var2; command | getline; close(command);}' \$TEMP_FILE
     mv "test.dep" \$DEPEND_FILE

# Generate the ObjectList file (LIST_FILE)
     awk '{print \$0".o \\\\";}' \$OBJ_LIST > \$LIST_FILE
# Add line to beginning of sorted file and remove \ from last line
     sort \$LIST_FILE > \$TEMP_FILE
     $WSED '1i\ObjectFiles = \\\\' \$TEMP_FILE > \$LIST_FILE
     sed '\$s/\\\\//' \$LIST_FILE > \$TEMP_FILE
     mv \$TEMP_FILE \$LIST_FILE
     rm \$OBJ_LIST
EOF

chmod u+x $STELLSH

LOC_AWK="#!"`which awk`
cat > $AWKFILE << EOF
$LOC_AWK -f
#AWK script to generate dependency (*.dep) file named DEPFILE in current directory
#NOTE ON USE: test.awk <path to filename.f(90)> to get dependencies from the controlling
#setup script; replace DEPFILE="test.dep" with name of dependency file
#Written by S. P. Hirshman (03/14/16)

function strip_extension(filename) {
#assumes only "." in filename (basename) precedes extension
     split(filename, vara, ".");
     return vara[1];
}

BEGIN {
     iout= 0;
     DEPFILE="test.dep"   #renamed in setup script
# ARGV[2] is the number of elements in the shell array (each element appears as a separate commandline arg)
     arrlen=ARGV[2]; 
# debug print "Len: "arrlen" ARGC: "ARGC;
# store in associative array for easy lookup
     for (i = 1; i<=arrlen; i++) {
        usename=ARGV[i+2]; upname=toupper(usename);
        usearray[upname] = usename; }
# clean up:reset ARGC to 2
     ARGC = 2
}
{    
     if (NR == 1) {
        myfile = "basename "FILENAME
        myfile | getline name;
#name of parent object-file in dependency list
        name  = strip_extension(name)".o: \\\\";
#debug  print "Filename: "FILENAME" BaseName: "name;
     }
     uctest = toupper(\$1)
     if (uctest == "USE") 
     {
#        parse possible comma in USE, ONLY: ... statements
         split(\$2, a, ",");
         uctest=toupper(a[1]);
#        do not store duplicates - use associative array "seen", initialized to 0
         bool = !seen[uctest];
         if (!seen[uctest]++) {
            record[++iout] = uctest;
         }
#debug   else print "uctest already exists: "uctest      
     }
}
END {
     if (iout == 0) exit;
     icollect = 0;
#    remove filename if it appears more than once in list
     for (icheck = 1; icheck<=iout; icheck++) {
        dep=record[icheck];

#    check if file exists in this folder and get correct case
#    (otherwise it is in a library, no need to include here)
#        dep = find_file(dep);
        dep = usearray[dep];
        if (dep == "") continue;
        dep = "      "dep".o";
        collect[++icollect] = dep;
     }
     if (icollect == 0) exit;  
     print name >> DEPFILE;
     for (i2=1; i2<=icollect; i2++) {
        dep=collect[i2];
        if (i2 != icollect)
           dep = dep" \\\\";
        print dep >> DEPFILE;
     }
     print "" >> DEPFILE;    #blank line separator at end
}
EOF
chmod u+x $AWKFILE
TOP_LEVEL_DIR=`pwd`

#---------------------------------------------------------------
#   Add "coilgeom" to FILES_TO_MAKE if "coilopt" is in FILES_TO_MAKE
