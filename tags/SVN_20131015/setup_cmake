#!/bin/bash
#
#  setup_cmake Chooses the correct cmake build command for a machine.
#
#-----------------------------------------------------------------------------

BUILD_TYPE=Release

MACHINE_ID=`uname -n`

echo Building v3fit suite for machine $MACHINE_ID
echo

if [ $# -eq 1 ]
then
	BUILD_TYPE=Debug
fi

echo cmake configured to generate a $BUILD_TYPE build.
if [ "$BUILD_TYPE" == Debug ]
then
	echo cmake may be reconfigured to generate a Debug build by running this script with no arguments or using the commmand	
	echo
	echo cmake -DCMAKE_BUILD_TYPE=Release
else
	echo cmake may be reconfigured to generate a Debug build by running this script with a Debug argument or using the commmand
	echo
	echo cmake -DCMAKE_BUILD_TYPE=Debug
fi

echo
if [ "$MACHINE_ID" == "blast1" ] || [ "$MACHINE_ID" == "blast2" ] || [ "$MACHINE_ID" == "blast3" ] || [ "$MACHINE_ID" == "blast4" ] || [ "$MACHINE_ID" == "recon" ] || [ "$MACHINE_ID" == "recon2" ]
then
	# These for machines are hosted on the Auburn network.

	cmake -DCMAKE_BUILD_TYPE:String=$BUILD_TYPE \
	      -DCMAKE_Fortran_COMPILER=gfortran     \
	      -DNETCDF_INC_PATH=/usr/include/       \
	      -DNETCDF_LIB_PATH=/usr/lib            \
	      -DCMAKE_Fortran_FLAGS=-DNEW_CODE      \
	      -DEXTRA_FLAGS=-fopenmp                \
	      -DEXTRA_RELEASE_FLAGS:String="-m64 -mfpmath=sse -march=native -msse4a -msse3"

elif [ "${MACHINE_ID#*.}" == "igi.cnr.it" ]; then

	# the machine is hosted on RFX's network:
	# for technical reasons, force compiling on ra22 only.

	if [ "${MACHINE_ID%%.*}" != "ra22" ]; then
	   echo " `basename $0`: you should compile on ra22!" && exit 1
	fi

	echo " `basename $0`: running cmake."
	cmake -DCMAKE_Fortran_FLAGS=-DNEW_CODE             \
	      -DEXTRA_RELEASE_FLAGS="-fp-model precise"    \
	      -DEXTRA_FLAGS=-openmp                        \
	      -DNETCDF_INC_PATH=/usr/local/netcdf/include/ \
	      -DNETCDF_LIB_PATH=/usr/local/netcdf/lib/     \
	      -DCMAKE_BUILD_TYPE=$BUILD_TYPE               \
	&&   echo " `basename $0`: cmake succeeded."       \
	|| ( echo " `basename $0`: cmake failed." && exit 2 )

else
# MACHINE_ID is new and unknown. Inform the user how to add support for this new machine.
	echo $MACHINE_ID not suported by this script.
	echo To support this machine, add a new elif statement of the form
	echo
	echo elif [ \$MACHINE_ID == \"$MACHINE_ID\" ]
	echo then
	echo "   " cmake -DVARIABLE=value ...
	echo
fi
