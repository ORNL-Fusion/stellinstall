\
\pard\tx529\pardeftab529\pardirnatural

\f1 \cf0 ip_chord_RPhiDegZ_int\
ip001\
1.0 0.0 0.0\
0.5 0.0 0.0\
\
ip_chord_RPhiDegZ_pol\
ip002\
1.0 0.0 0.0\
0.5 0.0 0.0
\f0 \

\f1 1E-4\
\
end_of_file
\f0 \
